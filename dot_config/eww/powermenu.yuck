(defwindow powermenu
    :monitor 0
    :stacking "overlay"
    :focusable "ondemand"
    :exclusive false
    :unfocus-close true
    :namespace "eww-powermenu"
    :geometry (geometry :anchor "top right" 
                        :y "10px"
                        :x "10px"
              )
    (powermenu_layout)
)

(defwidget powermenu_layout []
    (box :class "pwer-main"
         :spacing 15
         :space-evenly false
         :valign "center" :halign "center"
         :orientation "vertical"
         ;:show-truncated "false"
        (_buttons :shutdown "shutdown now"
                  :reboot "reboot"
                  :hibernate "eww close powermenu; systemctl hibernate; eww update any_hover=false; eww update hovered_class=''"
                  :sleep "playerctl -a pause; eww close powermenu; systemctl suspend; eww update any_hover=false; eww update hovered_class=''"
                  :logout {get_env("XDG_CURRENT_DESKTOP") == "niri" ? "niri msg action quit -s" : "loginctl kill-session self"}
                  :lock "eww close powermenu; swaylock & eww update any_hover=false; eww update hovered_class=''"
                  :shutdown_icon "" :reboot_icon "" :logout_icon ""
                  :hibernate_icon "" :sleep_icon "" :lock_icon ""
        )
        (button :class "pwer-close-button" :halign "end" :onclick "eww close powermenu" 
            (label :show-truncated "false" :text "")
        )
    )
)


(defvar any_hover false)
(defvar hovered_class "")

(defwidget _buttons [shutdown shutdown_icon
                     reboot reboot_icon
                     hibernate hibernate_icon
                     sleep sleep_icon
                     logout logout_icon
                     lock lock_icon]
    (box :class "pwer-btns-box${any_hover ? ' any-hover':''}"
         :spacing 5
         :vexpand true :hexpand true
         :space-evenly false
         :valign "center" :halign "center"
         :orientation "vertical"
        (_button :name "shutdown" :action shutdown :icon shutdown_icon)
        (_button :name "reboot" :action reboot :icon reboot_icon)
        (_button :name "hibernate" :action hibernate :icon hibernate_icon)
        (_button :name "sleep" :action sleep :icon sleep_icon)
        (_button :name "logout" :action logout :icon logout_icon)
        (_button :name "lock" :action lock :icon lock_icon)
    )
)

(defwidget _button [name action icon]
    (eventbox :onhover "eww update any_hover=true; eww update hovered_class=pwer-${name}"
              :onhoverlost "eww update any_hover=false; eww update hovered_class=''"
              :valign "center" :halign "end"
        (button :class "pwer-${name}" :onclick action
            (box :space-evenly false
                (revealer :transition "slideleft"
                          :reveal {hovered_class == "pwer-${name}"}
                          :duration "350ms"
                          (label :class "pwer-btn-desc" 
                                 :text name
                          )
                )
                (label :show-truncated false :text icon)
            )
        )
    )
)
