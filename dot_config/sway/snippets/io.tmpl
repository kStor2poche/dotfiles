#**--             --**#
# Input configuration #
#**--             --**#
input * {
    xkb_layout 'be'
    xkb_numlock enable
}

input type:touchpad {
    dwt disabled
    tap enabled
    drag enabled
    middle_emulation enabled
    natural_scroll enabled
    accel_profile "adaptive"
    pointer_accel 0.1
}

input "1267:41:Elan_TrackPoint" {
    dwtp enabled
    accel_profile "adaptive"
    pointer_accel -0.4
}

# External mouse tweaks
input type:pointer {
    accel_profile "flat"
    pointer_accel -0.7
}

#**--              --**#
# Output configuration #
#**--              --**#

# Wallpaper & general settings
output * {
    bg /usr/share/backgrounds/current fill
    adaptive_sync off
    max_render_time off
}

{{- if eq .chezmoi.hostname "archlaptop" }}
output eDP-1 pos 0 0 res 2560x1600@165.040Hz adaptive_sync off scale 1.5 subpixel rgb
{{- end }}
{{- if eq .chezmoi.hostname "archdesktop" }}
# Single screen config (has to be separate because of x11 & wine)
    output DP-1 pos 0 0 res 2560x1440@179.981Hz adaptive_sync off
# Dual screen config
    output DP-1 pos 1680 0 res 2560x1440@179.981Hz adaptive_sync off
    # output HDMI-A-1 pos 0 200 mode --custom 1680x1050@66Hz
# this gives weiiiiird results. srgb content looks horribly bad.
# color_profile icc /home/laio-shared/S27FG50xS.icm
# TODO: triangle subpixel ??
{{- end }}
{{- if eq .chezmoi.hostname "archleo" }}
output eDP-1 pos 0 0 res 1366x768@60.003Hz adaptive_sync off scale 1 subpixel rgb
{{- end }}


