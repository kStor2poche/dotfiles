# For gammastep (and mayhaps other services, as it is not started through the /etc/sway/config.d snippet)
exec "systemctl --user start sway-session.target"

# For gnome polkit authentication popup
exec "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"

# For playerctl player memory (TODO: check if it works)
exec "playerctld daemon"

# Systemd daemons
# exec_always dex -a

# And self explanatory stuff
