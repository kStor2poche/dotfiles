#**--             --**#
# Input configuration #
#**--             --**#
input * {
    xkb_layout 'be'
    xkb_numlock enable
}

input type:touchpad {
    dwt disabled
    tap enabled
    drag enabled
    middle_emulation enabled
    natural_scroll enabled
    accel_profile "adaptive"
    pointer_accel 0.1
}

input "1267:41:Elan_TrackPoint" {
    dwtp enabled
    accel_profile "adaptive"
    pointer_accel -0.4
}

# External mouse tweaks
input type:pointer {
    accel_profile "flat"
    pointer_accel -0.7
}

#**--              --**#
# Output configuration #
#**--              --**#

# Wallpaper & general settings
output * {
    bg /usr/share/backgrounds/current fill
    adaptive_sync off
    max_render_time off
}

