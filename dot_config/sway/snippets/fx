#**--      --**#
# SwayFX stuff #
#**--      --**#

# Minimize emulation
scratchpad_minimize enable

# Window corner radius in px
corner_radius 3

# Window bg blur
blur enable
blur_xray disable
blur_passes 5
blur_radius 10

# Inactive window dimming
default_dim_inactive 0.5
dim_inactive_colors.unfocused #0000005F
dim_inactive_colors.urgent #9000005F

shadows enable
shadow_color #00000040
shadow_blur_radius 15

# Add effects to certain layers
layer_effects "gtk-layer-shell" blur_ignore_transparent enable; blur enable; blur_xray disable; shadows disable;
layer_effects "eww-powermenu" blur_ignore_transparent enable; blur enable; blur_xray disable; shadows enable;
layer_effects "eww-statusbar" blur_ignore_transparent enable; blur enable; blur_xray enable; shadows disable;
layer_effects "notifications" blur_ignore_transparent enable; blur enable; blur_xray disable; shadows enable; corner_radius 3;
layer_effects "swaync-notification-window" blur_ignore_transparent enable; blur enable; blur_xray disable; shadows disable; corner_radius 3;
# layer_effects "wofi" blur_ignore_transparent enable; blur enable; blur_xray disable; shadows disable;

# vim:ft=config
